<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Juego de Microbiología - Exploración</title>
    <style>
        body {
            font-family: Arial, sans-serif;
            text-align: center;
            background-color: #f4f4f4;
            overflow: hidden;
        }
        #game-container {
            width: 800px;
            height: 400px;
            margin: 50px auto;
            background: url('https://via.placeholder.com/800x400?text=Laboratorio') no-repeat center;
            background-size: cover;
            position: relative;
            border: 2px solid black;
        }
        #character {
            width: 50px;
            height: 50px;
            background: url('https://via.placeholder.com/50x50?text=Cientifico') no-repeat center;
            background-size: cover;
            position: absolute;
            bottom: 10px;
            left: 10px;
            border-radius: 50%;
        }
        #question-box {
            display: none;
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            background: white;
            padding: 20px;
            border-radius: 10px;
            box-shadow: 0px 0px 10px rgba(0, 0, 0, 0.1);
        }
        button {
            margin-top: 10px;
            padding: 10px;
            border: none;
            background-color: #007bff;
            color: white;
            border-radius: 5px;
            cursor: pointer;
        }
        button:hover {
            background-color: #0056b3;
        }
    </style>
</head>
<body>
    <div id="game-container">
        <div id="character"></div>
        <div id="question-box">
            <h2 id="question"></h2>
            <button onclick="checkAnswer(0)" id="option1"></button>
            <button onclick="checkAnswer(1)" id="option2"></button>
            <button onclick="checkAnswer(2)" id="option3"></button>
        </div>
    </div>

    <script>
        let character = document.getElementById("character");
        let questionBox = document.getElementById("question-box");
        let questionText = document.getElementById("question");
        let options = [document.getElementById("option1"), document.getElementById("option2"), document.getElementById("option3")];
        
        let questions = [
            { 
                question: "¿Qué bacteria es responsable de la tuberculosis?", 
                options: ["Escherichia coli", "Mycobacterium tuberculosis", "Staphylococcus aureus"], 
                correct: 1 
            },
            { 
                question: "¿Qué hongo se usa en la producción de pan y cerveza?", 
                options: ["Saccharomyces cerevisiae", "Candida albicans", "Aspergillus flavus"], 
                correct: 0 
            },
            { 
                question: "¿Qué virus causa el SIDA?", 
                options: ["Influenza", "VIH", "Hepatitis B"], 
                correct: 1 
            }
        ];
        
        let currentQuestion = 0;
        let characterPosition = 10;
        
        document.addEventListener("keydown", function(event) {
            if (event.key === "ArrowRight") {
                characterPosition += 10;
                character.style.left = characterPosition + "px";
                
                if (characterPosition > 200 && !questionBox.style.display) {
                    showQuestion();
                }
            }
        });
        
        function showQuestion() {
            questionBox.style.display = "block";
            questionText.textContent = questions[currentQuestion].question;
            options.forEach((btn, index) => {
                btn.textContent = questions[currentQuestion].options[index];
            });
        }
        
        function checkAnswer(selected) {
            if (selected === questions[currentQuestion].correct) {
                alert("¡Correcto!");
                questionBox.style.display = "none";
                currentQuestion++;
                if (currentQuestion >= questions.length) {
                    alert("¡Felicidades! Has completado el juego.");
                }
            } else {
                alert("Incorrecto, intenta de nuevo.");
            }
        }
    </script>
</body>
</html>
